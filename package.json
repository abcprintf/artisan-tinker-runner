{
  "name": "artisan-tinker-runner",
  "displayName": "Artisan Tinker Runner",
  "description": "Sidebar panel with Monaco Editor, Syntax Highlighting & Execution History",
  "version": "2.2.4",
  "publisher": "abcprintf",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/abcprintf/artisan-tinker-runner.git" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["workspaceContains:artisan"],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "artisan-tinker-sidebar",
          "title": "Artisan Tinker",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "artisan-tinker-sidebar": [
        {
          "type": "webview",
          "id": "artisanTinkerView",
          "name": "Tinker Console"
        }
      ]
    },
    "commands": [
      {
        "command": "artisan-tinker-runner.openPanel",
        "title": "Open Artisan Tinker Panel"
      }
    ]
  },
  "scripts": { "vscode:prepublish": "" }
}